{
  "name": "AutoForwardX",
  "description": "Telegram's Best Smart Plugin File Forward Bot",
  "stack": "container",
  "keywords": [
    "telegram",
    "file",
    "forward",
    "bot"
  ],
  "successurl": "https://t.me/DmOwner",
  "repository": "https://github.com/dwnskhere/dwnsk-ForwardBot/tree/dev",
  "env": {
    "APIID": {
      "description": "Get this value from https://my.telegram.org",
      "value": ""
    },
    "APIHASH": {
      "description": "Get this value from https://my.telegram.org",
      "value": ""
    },
    "BOTTOKEN": {
      "description": "Your Telegram bot token from @BotFather",
      "value": ""
    },
    "BOTOWNERID": {
      "description": "Enter your Telegram user ID",
      "value": ""
    },
    "BANNEDUSERS": {
      "description": "Comma-separated Telegram user IDs to ban",
      "required": false,
      "value": ""
    },
    "DATABASENAME": {
      "description": "Default file type filter (document, audio, photo, video, animation)",
      "value": "document"
    },
    "DATABASE_URI": {
      "description": "Your MongoDB connection URI",
      "value": ""
    }
  },
  "formation": {
    "worker": {
      "quantity": 1,
      "size": "free"
    }
  }
}
